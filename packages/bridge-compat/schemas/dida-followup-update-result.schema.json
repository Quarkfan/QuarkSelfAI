{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "title", "summary", "changes", "url"],
  "properties": {
    "taskId": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "changes": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } },
    "url": { "type": "string" }
  }
}
