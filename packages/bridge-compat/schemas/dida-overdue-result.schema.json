{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks", "summary"],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "title", "dueDate", "priority", "url"],
        "properties": {
          "taskId": { "type": "string" },
          "title": { "type": "string" },
          "dueDate": { "type": "string" },
          "priority": { "type": "integer" },
          "url": { "type": ["string", "null"] }
        }
      }
    },
    "summary": { "type": "string" }
  }
}
