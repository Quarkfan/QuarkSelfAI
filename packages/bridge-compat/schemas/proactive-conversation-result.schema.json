{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "question", "reason", "answerUse", "knowledgeKey", "cardTitle", "cardTone", "valueScore", "revisitAfterHours"],
  "properties": {
    "decision": { "type": "string", "enum": ["ask", "skip"] },
    "question": { "type": "string" },
    "reason": { "type": "string" },
    "answerUse": { "type": "string" },
    "knowledgeKey": { "type": "string" },
    "cardTitle": { "type": "string" },
    "cardTone": { "type": "string", "enum": ["blue", "green", "yellow", "grey"] },
    "valueScore": { "type": "integer" },
    "revisitAfterHours": { "type": "integer" }
  }
}
