{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "projectId", "title", "titlePrefix", "urgencyLabel", "keyItem", "url", "created", "taskAction", "intakeDecision", "matterResolution", "matchedMatterKey", "matterMatchReason", "unfinishedOutcome", "responsibilityEvidence", "stateChangeOnCompletion", "topicAnchor", "groundingEvidence", "deadlineEvidence", "requestType", "approvalRequired", "approvalSummary", "actionRequired", "actionOwner", "nextAction", "notificationDecision", "notificationMode", "notificationDelayMinutes", "notificationTitle", "ownerMessage", "cardTone", "notificationReason", "materialChangeSummary", "summary", "priority", "tags", "dueDate", "relationshipSummary", "needsClarification", "clarificationQuestion", "clarificationReason", "blacklakeRelated", "blacklakeDomains", "recommendedSkills", "skillDecisionReason", "researchDecision", "researchChannel", "researchDecisionReason", "researchPrompt"],
  "properties": {
    "taskId": { "type": "string" },
    "projectId": { "type": "string" },
    "title": { "type": "string" },
    "titlePrefix": { "type": "string", "enum": ["【紧急·关键】", "【紧急】", "【重要·关键】", "【重要】", "【跟进·关键】", "【跟进】", "【关注】"] },
    "urgencyLabel": { "type": "string", "enum": ["紧急", "重要", "跟进", "关注"] },
    "keyItem": { "type": "boolean" },
    "url": { "type": ["string", "null"] },
    "created": { "type": "boolean" },
    "taskAction": { "type": "string", "enum": ["created", "updated", "unchanged", "ignored"] },
    "intakeDecision": { "type": "string", "enum": ["task", "followup", "information"] },
    "matterResolution": { "type": "string", "enum": ["existing", "new", "none", "ambiguous"] },
    "matchedMatterKey": { "type": "string" },
    "matterMatchReason": { "type": "string" },
    "unfinishedOutcome": { "type": "string" },
    "responsibilityEvidence": { "type": "string" },
    "stateChangeOnCompletion": { "type": "string" },
    "topicAnchor": { "type": "string", "maxLength": 80 },
    "groundingEvidence": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 240 } },
    "deadlineEvidence": { "type": "string", "maxLength": 240 },
    "requestType": { "type": "string", "enum": ["execution", "approval", "information"] },
    "approvalRequired": { "type": "boolean" },
    "approvalSummary": { "type": "string" },
    "actionRequired": { "type": "boolean" },
    "actionOwner": { "type": "string", "enum": ["changdongxu", "shared", "other", "unknown"] },
    "nextAction": { "type": "string" },
    "notificationDecision": { "type": "string", "enum": ["notify", "silent"] },
    "notificationMode": { "type": "string", "enum": ["realtime", "digest", "silent"] },
    "notificationDelayMinutes": { "type": "integer" },
    "notificationTitle": { "type": "string" },
    "ownerMessage": { "type": "string" },
    "cardTone": { "type": "string", "enum": ["blue", "green", "yellow", "red", "grey"] },
    "notificationReason": { "type": "string" },
    "materialChangeSummary": { "type": "string" },
    "summary": { "type": "string" },
    "priority": { "type": "integer", "enum": [0, 1, 3, 5] },
    "tags": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string" } },
    "dueDate": { "type": ["string", "null"] },
    "relationshipSummary": { "type": "string" },
    "needsClarification": { "type": "boolean" },
    "clarificationQuestion": { "type": "string" },
    "clarificationReason": { "type": "string" },
    "blacklakeRelated": { "type": "boolean" },
    "blacklakeDomains": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
    "recommendedSkills": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
    "skillDecisionReason": { "type": "string" },
    "researchDecision": { "type": "string", "enum": ["skip", "confirm", "start"] },
    "researchChannel": { "type": "string", "enum": ["none", "codex", "xiaowei"] },
    "researchDecisionReason": { "type": "string" },
    "researchPrompt": { "type": "string" }
  }
}
