import type { Context } from '@deepseek-ai/cordis'

export const name = 'feature-id'
export const inject = ['requiredSkeletonService']

export interface FeatureConfig {
  readonly enabled?: boolean
}

export function apply(ctx: Context, config: FeatureConfig = {}): void {
  if (config.enabled === false) return
  const requiredPort = ctx.requiredSkeletonService
  // Register a Service or lifecycle-owned effects here. Do not start work at module import time.
  ctx.effect(() => {
    // Capture injected ports before registering long-lived callbacks. Business
    // schedules belong in durable workflow wakeAt, never a private interval.
    void requiredPort
    return () => {
      // dispose every listener and child process
    }
  }, 'feature-id lifecycle')
}
