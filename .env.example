ASSISTANT_STORAGE=sqlite
ASSISTANT_EXECUTION_MODE=local
# JSON array. Only these local trees may be exposed to execution providers.
# ASSISTANT_WORKSPACE_ROOTS=["/Users/your-name/BlackLakeWork"]
SQLITE_PATH=var/quarkselfai.sqlite3
WEB_HOST=127.0.0.1
WEB_PORT=3210
CONSOLE_TOKEN=
CONSOLE_SECURE_COOKIE=false
CONTROL_PLANE_TOKEN=
LARK_IDENTITY=bot
QUARK_APPLICATION_MODE=compatibility
ASSISTANT_RUNTIME=control-only
# COMPAT_CONFIG_PATH=/absolute/path/to/bridge-config.json
# TAKEOVER_CONFIRMED=false
WORK_JOURNAL_ENABLED=true
WORK_JOURNAL_CLOSE_HOUR=5
WORK_JOURNAL_POLL_INTERVAL_MS=3600000
WORK_JOURNAL_MODEL_TIMEOUT_MS=900000
WORK_JOURNAL_LARK_CLI=lark-cli

# Recovery resources are intentionally external to Git. The target must be off-device and versioned;
# the age recipient is a public key, while its private key remains in the owner's secret manager.
# QUARK_RECOVERY_TARGET=s3://private-bucket/quarkselfai
# QUARK_RECOVERY_AGE_RECIPIENT=age1...
