# Default: local SQLite with no external dependency.
ASSISTANT_STORAGE=sqlite
SQLITE_PATH=var/quarkselfai.sqlite3

# PostgreSQL alternative:
# ASSISTANT_STORAGE=postgres
# DATABASE_URL=postgresql://quarkselfai:change-me@127.0.0.1:5432/quarkselfai

WEB_HOST=127.0.0.1
WEB_PORT=3210
# Required when WEB_HOST is not loopback.
# CONSOLE_TOKEN=replace-with-a-long-random-value
# Set to true when the console is exposed through HTTPS.
CONSOLE_SECURE_COOKIE=false

LARK_CLI_EXECUTABLE=lark-cli
LARK_IDENTITY=bot
