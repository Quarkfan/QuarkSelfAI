{
  "name": "@quarkfan/quark-self-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "Plugin-based Feishu work assistant powered by DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Quarkfan/QuarkSelfAI.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js"
    },
    "./blacklake": {
      "types": "./dist/blacklake/plugin.d.ts",
      "import": "./dist/blacklake/plugin.js"
    },
    "./feishu-ingress": {
      "types": "./dist/lark/ingress-plugin.d.ts",
      "import": "./dist/lark/ingress-plugin.js"
    },
    "./collaboration-learning": {
      "types": "./dist/collaboration/plugin.d.ts",
      "import": "./dist/collaboration/plugin.js"
    },
    "./executor-router": {
      "types": "./dist/execution/plugin.d.ts",
      "import": "./dist/execution/plugin.js"
    },
    "./action-ledger": {
      "types": "./dist/execution/ledger-plugin.d.ts",
      "import": "./dist/execution/ledger-plugin.js"
    },
    "./action-worker": {
      "types": "./dist/execution/worker-plugin.d.ts",
      "import": "./dist/execution/worker-plugin.js"
    },
    "./dsh-conversation-effects": {
      "types": "./dist/conversation/dsh-effect-plugin.d.ts",
      "import": "./dist/conversation/dsh-effect-plugin.js"
    },
    "./durable-state": {
      "types": "./dist/storage/plugin.d.ts",
      "import": "./dist/storage/plugin.js"
    },
    "./durable-workflows": {
      "types": "./dist/workflow/plugin.d.ts",
      "import": "./dist/workflow/plugin.js"
    },
    "./durable-events": {
      "types": "./dist/events/runtime.d.ts",
      "import": "./dist/events/runtime.js"
    },
    "./message-intake": {
      "types": "./dist/intake/plugin.d.ts",
      "import": "./dist/intake/plugin.js"
    },
    "./intake-interaction-effects": {
      "types": "./dist/intake/interaction-effect-plugin.d.ts",
      "import": "./dist/intake/interaction-effect-plugin.js"
    },
    "./dsh-reasoning-effects": {
      "types": "./dist/reasoning/dsh-effect-plugin.d.ts",
      "import": "./dist/reasoning/dsh-effect-plugin.js"
    },
    "./dida-maintenance": {
      "types": "./dist/task-maintenance/plugin.d.ts",
      "import": "./dist/task-maintenance/plugin.js"
    },
    "./task-system": {
      "types": "./dist/task-system/effects.d.ts",
      "import": "./dist/task-system/effects.js"
    },
    "./dida-task-effects": {
      "types": "./dist/task-system/dida-plugin.d.ts",
      "import": "./dist/task-system/dida-plugin.js"
    },
    "./dida-projection-effects": {
      "types": "./dist/task-system/projection-plugin.d.ts",
      "import": "./dist/task-system/projection-plugin.js"
    },
    "./session-lifecycle": {
      "types": "./dist/session-lifecycle/plugin.d.ts",
      "import": "./dist/session-lifecycle/plugin.js"
    },
    "./codex-session-effects": {
      "types": "./dist/session-lifecycle/codex-effect-plugin.d.ts",
      "import": "./dist/session-lifecycle/codex-effect-plugin.js"
    },
    "./feishu-effects": {
      "types": "./dist/lark/effects.d.ts",
      "import": "./dist/lark/effects.js"
    },
    "./feishu-workflow-effects": {
      "types": "./dist/lark/effect-plugin.d.ts",
      "import": "./dist/lark/effect-plugin.js"
    },
    "./feishu-context-effects": {
      "types": "./dist/lark/context-effect-plugin.d.ts",
      "import": "./dist/lark/context-effect-plugin.js"
    },
    "./feishu-focus-discovery-effects": {
      "types": "./dist/lark/discovery-effect-plugin.d.ts",
      "import": "./dist/lark/discovery-effect-plugin.js"
    },
    "./xiaowei-research": {
      "types": "./dist/xiaowei/plugin.d.ts",
      "import": "./dist/xiaowei/plugin.js"
    },
    "./followup": {
      "types": "./dist/followup/plugin.d.ts",
      "import": "./dist/followup/plugin.js"
    },
    "./dynamic-plugin-policy": {
      "types": "./dist/runtime/dynamic-plugin-policy.d.ts",
      "import": "./dist/runtime/dynamic-plugin-policy.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/index.js.map",
    "dist/app.js",
    "dist/app.d.ts",
    "dist/app.d.ts.map",
    "dist/app.js.map",
    "dist/bootstrap",
    "dist/platform",
    "dist/domain",
    "dist/lark",
    "dist/storage",
    "dist/config",
    "dist/web",
    "dist/policy",
    "dist/runtime",
    "dist/execution",
    "dist/conversation",
    "dist/migration",
    "dist/deploy",
    "dist/blacklake",
    "dist/collaboration",
    "dist/workflow",
    "dist/events",
    "dist/intake",
    "dist/task-maintenance",
    "dist/task-system",
    "dist/session-lifecycle",
    "dist/xiaowei",
    "dist/followup",
    "migrations",
    "config",
    "web",
    "deploy",
    "packages/bridge-compat",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm run architecture:check && npm test",
    "test": "node --import tsx --test test/*.test.ts && npm test --workspace @quarkfan/bridge-compat",
    "architecture:check": "node --import tsx scripts/check-architecture.ts",
    "compat:lark": "node --import tsx scripts/check-lark-compat.ts",
    "compat:dsh": "npm run build && node --import tsx scripts/check-dsh-compat.ts",
    "compat:blacklake": "npm run build && node --import tsx scripts/check-blacklake-references.ts",
    "compat:live-bridge": "node --import tsx scripts/check-bridge-drift.ts",
    "compat:server": "node --import tsx scripts/check-server-runtime.ts && sh -n deploy/container-entrypoint.sh",
    "setup:dsh": "node --import tsx scripts/setup-dsh-profile.ts",
    "audit:legacy-state": "node --import tsx scripts/audit-legacy-state.ts",
    "audit:legacy-handoff": "node --import tsx scripts/audit-legacy-handoff.ts",
    "audit:collaboration-handoff": "node --import tsx scripts/audit-collaboration-handoff.ts",
    "audit:dida-maintenance-handoff": "node --import tsx scripts/audit-dida-maintenance-handoff.ts",
    "audit:session-lifecycle-handoff": "node --import tsx scripts/audit-session-lifecycle-handoff.ts",
    "audit:xiaowei-research-handoff": "node --import tsx scripts/audit-xiaowei-research-handoff.ts",
    "audit:followup-handoff": "node --import tsx scripts/audit-followup-handoff.ts",
    "audit:message-intake-handoff": "node --import tsx scripts/audit-message-intake-handoff.ts",
    "audit:shadow": "node --import tsx scripts/audit-shadow-state.ts",
    "audit:dida-projections": "node scripts/audit-dida-projections.mjs",
    "audit:recovery": "node --import tsx scripts/audit-recovery-readiness.ts",
    "backup:recovery": "node --import tsx scripts/recovery-bundle.ts create",
    "restore:stage": "node --import tsx scripts/recovery-bundle.ts stage",
    "restore:prepare-safe": "node --import tsx scripts/recovery-bundle.ts prepare",
    "start:restore-safe": "node --env-file=var/restore-safe.env dist/app.js",
    "rehearse:policy": "node --import tsx scripts/rehearse-policy.ts",
    "rehearse:executor-fallback": "node --import tsx scripts/rehearse-executor-fallback.ts",
    "rehearse:notification-recovery": "node scripts/rehearse-notification-recovery.mjs",
    "snapshot:legacy-state": "node --import tsx scripts/snapshot-legacy-state.ts",
    "prepare:compat-handoff": "node --import tsx scripts/prepare-compat-handoff.ts",
    "replay:legacy-dida": "node scripts/replay-legacy-dida.mjs",
    "cleanup:completed-state": "node --env-file=var/runtime.env scripts/prune-completed-compat-state.mjs",
    "register:compat-state": "node --env-file=var/runtime.env --import tsx scripts/register-compat-state.ts",
    "takeover:preflight": "node --import tsx scripts/takeover-preflight.ts",
    "render:launchd": "node --import tsx scripts/render-launchd.ts",
    "dev": "node --import tsx src/app.ts",
    "start": "node dist/app.js"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-claude-code": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-codex": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-cordis": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
