{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quarkself.ai/schemas/capability-manifest-v1.json",
  "title": "Capability Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "kind", "description", "source", "runtime", "requirements", "lifecycle", "interfaces", "dependencies", "permissions", "dataClasses", "tests", "healthChecks", "recovery"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "version": {"$ref": "#/$defs/version"},
    "kind": {"enum": ["skill", "knowledge", "policy", "workflow", "connector", "package", "sdk", "cli", "binary", "project", "browser-runtime", "container", "notebook", "sandbox", "application", "game", "simulation", "integration-pack", "agent", "composite"]},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "locator", "revision", "artifactDigest", "license", "supplier", "signature", "sbom"],
      "properties": {
        "kind": {"enum": ["git", "registry", "local-build", "first-party"]},
        "locator": {"type": "string", "minLength": 1, "maxLength": 1000},
        "revision": {"type": "string", "minLength": 1, "maxLength": 200},
        "artifactDigest": {"$ref": "#/$defs/digest"},
        "license": {"type": "string", "minLength": 1, "maxLength": 100},
        "supplier": {"type": "string", "minLength": 1, "maxLength": 200},
        "signature": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["verified", "missing", "invalid"]}, "keyId": {"type": "string", "minLength": 1, "maxLength": 300}}},
        "sbom": {"type": "object", "additionalProperties": false, "required": ["format"], "properties": {"format": {"enum": ["spdx", "cyclonedx", "none"]}, "digest": {"$ref": "#/$defs/digest"}}}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["placements", "isolation", "supportedPlatforms", "executorRequirements", "stateNamespace", "offlineCapable"],
      "properties": {
        "placements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["local", "cloud", "hybrid"]}},
        "isolation": {"enum": ["pure", "process", "container", "browser-profile", "vm", "remote-service"]},
        "supportedPlatforms": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "executorRequirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "stateNamespace": {"$ref": "#/$defs/id"},
        "offlineCapable": {"type": "boolean"}
      }
    },
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["install", "load", "start", "stop", "upgrade", "uninstall", "recover"],
      "properties": {
        "install": {"$ref": "#/$defs/lifecycleHandler"}, "load": {"$ref": "#/$defs/lifecycleHandler"},
        "start": {"$ref": "#/$defs/lifecycleHandler"}, "stop": {"$ref": "#/$defs/lifecycleHandler"},
        "upgrade": {"$ref": "#/$defs/lifecycleHandler"}, "uninstall": {"$ref": "#/$defs/lifecycleHandler"},
        "recover": {"$ref": "#/$defs/lifecycleHandler"}
      }
    },
    "interfaces": {"type": "array", "items": {"$ref": "#/$defs/interface"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "permissions": {"type": "array", "items": {"$ref": "#/$defs/permission"}},
    "dataClasses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "tests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test"}},
    "healthChecks": {"type": "array", "items": {"$ref": "#/$defs/healthCheck"}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["strategy", "rollbackVersion", "stateIncluded", "restoreEffectsEnabled"], "properties": {"strategy": {"enum": ["stateless", "reinstall", "snapshot", "encrypted-state"]}, "rollbackVersion": {"type": ["string", "null"]}, "stateIncluded": {"type": "boolean"}, "restoreEffectsEnabled": {"const": false}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}(/[a-z0-9][a-z0-9.-]{0,63})?$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "interface": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "version", "direction", "compatibility"], "properties": {"kind": {"enum": ["tool", "port", "event", "resource", "ui", "runtime", "experience"]}, "id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}, "direction": {"enum": ["provides", "requires"]}, "inputSchema": {"type": "string"}, "outputSchema": {"type": "string"}, "compatibility": {"type": "array", "items": {"type": "string"}}}},
    "dependency": {"type": "object", "additionalProperties": false, "required": ["id", "versionRange", "required"], "properties": {"id": {"$ref": "#/$defs/id"}, "versionRange": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}, "placement": {"enum": ["local", "cloud", "hybrid"]}}},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "versionRange", "placement", "required"], "properties": {"kind": {"enum": ["system", "model", "executor", "package", "network", "device", "capability"]}, "id": {"$ref": "#/$defs/id"}, "versionRange": {"type": ["string", "null"]}, "placement": {"enum": ["local", "cloud", "hybrid"]}, "required": {"type": "boolean"}}},
    "lifecycleHandler": {"type": "object", "additionalProperties": false, "required": ["handlerInterface", "supported", "approval"], "properties": {"handlerInterface": {"$ref": "#/$defs/id"}, "supported": {"type": "boolean"}, "approval": {"enum": ["none", "install", "session", "action"]}}},
    "permission": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "operations", "scope", "placement", "approval", "required", "dataClasses"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["workspace", "file", "browser", "desktop", "network", "secret-reference", "process", "container", "gpu", "port", "data", "external-effect"]}, "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["discover", "read", "write", "execute", "connect", "listen", "render", "persist"]}}, "scope": {"type": "string", "minLength": 1, "maxLength": 500}, "placement": {"enum": ["local", "cloud", "hybrid"]}, "approval": {"enum": ["none", "install", "session", "action"]}, "required": {"type": "boolean"}, "dataClasses": {"type": "array", "items": {"type": "string"}}, "effect": {"type": "object", "additionalProperties": false, "required": ["kind", "externalWrite", "writeVerificationRequired"], "properties": {"kind": {"type": "string", "minLength": 1}, "externalWrite": {"type": "boolean"}, "writeVerificationRequired": {"type": "boolean"}}}}},
    "test": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "required", "effectMode"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["contract", "fixture", "redacted-replay", "health", "shadow"]}, "required": {"type": "boolean"}, "effectMode": {"enum": ["none", "recording-sink"]}}},
    "healthCheck": {"type": "object", "additionalProperties": false, "required": ["id", "interfaceId", "placement", "timeoutMs", "required"], "properties": {"id": {"$ref": "#/$defs/id"}, "interfaceId": {"$ref": "#/$defs/id"}, "placement": {"enum": ["local", "cloud", "hybrid"]}, "timeoutMs": {"type": "integer", "minimum": 1}, "required": {"type": "boolean"}}}
  }
}
