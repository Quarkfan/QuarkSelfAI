{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quarkself.ai/schemas/artifact-verification-report-v1.json",
  "title": "Artifact Verification Report V1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "capabilityId", "version", "artifactDigest", "sourceRevision", "policyRevision", "checks", "decision", "evaluatedAt"],
  "properties": {
    "schemaVersion": {"const": 1}, "capabilityId": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
    "artifactDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "sourceRevision": {"type": "string", "minLength": 1},
    "policyRevision": {"type": "string", "minLength": 1},
    "checks": {"type": "object", "additionalProperties": false, "required": ["license", "signature", "sbom", "malware", "maintenance", "dependencies"], "properties": {"license": {"enum": ["pass", "warn", "fail"]}, "signature": {"enum": ["pass", "warn", "fail"]}, "sbom": {"enum": ["pass", "warn", "fail"]}, "malware": {"enum": ["pass", "warn", "fail"]}, "maintenance": {"enum": ["pass", "warn", "fail"]}, "dependencies": {"enum": ["pass", "warn", "fail"]}}},
    "decision": {"enum": ["verified", "rejected"]}, "evaluatedAt": {"type": "string", "format": "date-time"}
  }
}
