{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quarkself.ai/schemas/device-identity-v1.json",
  "title": "Device Identity V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "userId", "deviceId", "publicKey", "keyAlgorithm", "createdAt", "attestation"],
  "properties": {
    "schemaVersion": {"const": 1},
    "tenantId": {"$ref": "#/$defs/id"}, "userId": {"$ref": "#/$defs/id"}, "deviceId": {"$ref": "#/$defs/id"},
    "publicKey": {"type": "string", "minLength": 1}, "keyAlgorithm": {"const": "ed25519"},
    "createdAt": {"type": "string", "format": "date-time"},
    "attestation": {"type": "object", "additionalProperties": false, "required": ["kind", "reference"], "properties": {"kind": {"enum": ["self", "platform"]}, "reference": {"type": "string", "minLength": 1}}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"}}
}
